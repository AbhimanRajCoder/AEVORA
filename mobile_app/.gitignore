# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Environment variables & secrets (Never commit secrets; keep .env.example)
.env
.env.*
!.env.example

# Expo & EAS
.expo/
dist/
web-build/
expo-env.d.ts

# Native signing keys and certificates
*.keystore
*.jks
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Build outputs
*.apk
*.aab
*.xapk
*.ipa

# Native and generated folders
.kotlin/
.gradle/
build/
*.orig.*
/ios
/android

# Metro
.metro-health-check*

# Debug logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS & OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Editor and IDE configurations
.vscode/
.idea/
.claude/
*.swp
*.swo
